// @@ALGO@@ on an FPGA (hash mode @@MODE@@): the hooks of the shared FPGA bridge,
// src/bridges/fpga/hcfpga_bridge.c. The gateware is src/fpga/@@ALGO@@, see its README for every
// value below.

#include "common.h"
#include "types.h"
#include "bridges.h"

#include "fpga/hcfpga_bridge.h"
#include "fpga/hcfpga_@@ALGO@@_ref.h"

// The module's and the kernel's tmp struct (module_@@MODE@@.c, m@@MODE@@-pure.cl): the password,
// the digest words the device returns. All three files keep the same struct.

typedef struct @@ALGO@@_bridge_tmp
{
  u32 pw_len;

  u32 pw_buf[@@PW_WORDS@@];

  u32 digest[@@DIGEST_WORDS@@];

} @@ALGO@@_bridge_tmp_t;

@@CONFIG_EXTRA@@
// The canary's reference: the digest the device returns for pw under salt, as hashcat's
// digest_buf words.

static void @@ALGO@@_canary_digest (const u8 *pw, const u32 pw_len, const salt_t *salt, u32 *digest)
{
  const u32 salt_len = MIN (salt->salt_len, (u32) sizeof (salt->salt_buf));

  hcfpga_@@ALGO@@ (pw, pw_len, (const u8 *) salt->salt_buf, salt_len, salt->salt_iter, digest);
}

static const hcfpga_algo_t @@ALGO_UC@@ =
{
  .name = "@@ALGO@@",

  HCFPGA_TMP_LAYOUT (@@ALGO@@_bridge_tmp_t),

  // HCFPGA-TODO: the longest password the core takes.
  .pw_max = @@PW_MAX@@,

  // HCFPGA-TODO: candidates in flight per core the identity's cores= counts.
  .grain_per_core = @@GRAIN@@,

  // HCFPGA-TODO: what the C2H core_id names.
  .core_name = "@@CORE_NAME@@",

  // HCFPGA-TODO: what the core computes. The module refuses anything else at parse time too.
  .salt_len_min = @@SALT_MIN@@,
  .salt_len_max = @@SALT_MAX@@,
  .iter_min     = @@ITER_MIN@@,
  .iter_max     = @@ITER_MAX@@,

  // HCFPGA-TODO: generous cycles for one iteration of one wave, for the batch timeout.
  .wait_cycles_per_iter = 1000,

  // No board measured yet: every board is autotuned. Rows come from hcfpga_step --wave-model.
  .wave_models = NULL,

  // The known-answer canary's password, at most pw_max bytes (NULL: "hcfpga-ztex-canary").
  .canary_pw = @@CANARY_PW@@,

  .canary_digest   = @@ALGO@@_canary_digest,
  .config_regs     = NULL,
  .config_extra    = @@CONFIG_EXTRA_FN@@,
  .digest_from_c2h = NULL,   // HCFPGA-TODO: hcfpga_digest_swap32 or a function, if C2H order is not digest_buf's
  .salt_check      = NULL,
  .diag_hint       = NULL,
};

void bridge_init (bridge_ctx_t *bridge_ctx)
{
  hcfpga_bridge_init (bridge_ctx, &@@ALGO_UC@@);
}
