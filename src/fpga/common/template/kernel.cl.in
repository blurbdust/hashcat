#ifdef KERNEL_STATIC
#include M2S(INCLUDE_PATH/inc_vendor.h)
#include M2S(INCLUDE_PATH/inc_types.h)
#include M2S(INCLUDE_PATH/inc_platform.cl)
#include M2S(INCLUDE_PATH/inc_common.cl)
#endif

#define COMPARE_S M2S(INCLUDE_PATH/inc_comp_single.cl)
#define COMPARE_M M2S(INCLUDE_PATH/inc_comp_multi.cl)

// @@ALGO@@ on an FPGA (fpga_@@ALGO@@ bridge): init hands the candidate to the bridge, the bridge
// replaces the loop and writes back the digest words the device returns, comp compares them.

typedef struct @@ALGO@@_bridge_tmp
{
  u32 pw_len;

  u32 pw_buf[@@PW_WORDS@@];

  u32 digest[@@DIGEST_WORDS@@];

} @@ALGO@@_bridge_tmp_t;

KERNEL_FQ KERNEL_FA void m@@MODE@@_init (KERN_ATTR_TMPS (@@ALGO@@_bridge_tmp_t))
{
  const u64 gid = get_global_id (0);

  if (gid >= GID_CNT) return;

  tmps[gid].pw_len = pws[gid].pw_len;

  for (u32 i = 0; i < @@PW_WORDS@@; i++)
  {
    tmps[gid].pw_buf[i] = pws[gid].i[i];
  }

  for (u32 i = 0; i < @@DIGEST_WORDS@@; i++)
  {
    tmps[gid].digest[i] = 0;
  }
}

KERNEL_FQ KERNEL_FA void m@@MODE@@_loop (KERN_ATTR_TMPS (@@ALGO@@_bridge_tmp_t))
{
}

KERNEL_FQ KERNEL_FA void m@@MODE@@_comp (KERN_ATTR_TMPS (@@ALGO@@_bridge_tmp_t))
{
  const u64 gid = get_global_id (0);

  if (gid >= GID_CNT) return;

  const u32 r0 = tmps[gid].digest[DGST_R0];
  const u32 r1 = tmps[gid].digest[DGST_R1];
  const u32 r2 = tmps[gid].digest[DGST_R2];
  const u32 r3 = tmps[gid].digest[DGST_R3];

  #define il_pos 0

  #ifdef KERNEL_STATIC
  #include COMPARE_M
  #endif
}
